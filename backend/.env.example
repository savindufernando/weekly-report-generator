# Copy to .env and fill in. Never commit .env.
# Keep comments on their own lines — trailing "# ..." after a value is a
# parsing hazard for anything that doesn't strip it.

# --- database ---
# XAMPP default: user "root", empty password, port 3306.
# ?charset=utf8mb4 is REQUIRED. Without it the connection negotiates latin1
# and non-ASCII text is silently replaced with "?" on the way in.
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/weekly_reports?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/weekly_reports_test?charset=utf8mb4
SQL_ECHO=false

# --- auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-a-real-64-char-hex-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- cookies (refresh token) ---
# COOKIE_SECURE must be true in production (requires HTTPS).
# COOKIE_SAMESITE must be "none" when the frontend and API are on different
# domains — and "none" requires "secure".
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- app ---
# ENVIRONMENT: development | production
ENVIRONMENT=development
PROJECT_NAME=Weekly Report Generator
# Comma-separated. Never "*" — browsers reject wildcard origins with credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# --- business rules ---
# Hours after the week ends before a FIRST submission counts as "late".
# The brief never defines a deadline; this is our documented assumption.
SUBMISSION_DEADLINE_GRACE_HOURS=24

# --- ai assistant (bonus) ---
# The app runs fully with AI_ENABLED=false and no API key.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
